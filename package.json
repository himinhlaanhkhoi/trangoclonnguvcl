{
  "name": "taixiu-ai-prediction",
  "version": "2.0.0",
  "description": "AI Tài Xỉu Prediction System with 50+ algorithms, Markov Chain, Technical Indicators, and Machine Learning",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test.js",
    "pm2:start": "pm2 start server.js --name taixiu-ai",
    "pm2:stop": "pm2 stop taixiu-ai",
    "pm2:restart": "pm2 restart taixiu-ai",
    "pm2:logs": "pm2 logs taixiu-ai",
    "pm2:status": "pm2 status taixiu-ai"
  },
  "keywords": [
    "taixiu",
    "sicbo",
    "ai",
    "prediction",
    "gambling",
    "markov-chain",
    "machine-learning",
    "pattern-recognition",
    "technical-analysis"
  ],
  "author": "@vuaoccac",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.7",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "pm2": "^5.3.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vuaoccac/taixiu-ai.git"
  },
  "bugs": {
    "url": "https://github.com/vuaoccac/taixiu-ai/issues"
  },
  "homepage": "https://github.com/vuaoccac/taixiu-ai#readme",
  "nodemonConfig": {
    "watch": [
      "server.js",
      "learning_data.json",
      "prediction_history.json"
    ],
    "ignore": [
      "node_modules",
      "*.log"
    ],
    "delay": "1000"
  }
}
